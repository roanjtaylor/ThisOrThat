{
  "branch": "dive-watches",
  "rubric": {
    "requiredView": "A straight-on or only slightly-angled shot of the watch face with the WHOLE watch (case, dial, bezel, and hands) clearly visible and legible. A clean product/studio shot is ideal; an off-wrist shot is fine. Avoid wrist shots where the watch is small or angled away.",
    "minLongEdgePx": 900,
    "reject": [
      "toy, replica, or homage of a different brand",
      "3D render, CGI, or illustration (must be a real photograph)",
      "heavy watermark, price tag, or dealer text overlay",
      "movement-only, caseback-only, or box-and-papers shot",
      "watch tiny in frame, cropped, or strongly angled so the dial is not legible",
      "wrong model / reference / generation",
      "blurry or low resolution"
    ],
    "prefer": [
      "clean studio or product shot on a plain background",
      "dial facing the camera, fully legible",
      "sharp macro focus with the watch as the clear subject",
      "shows the bezel and dial design clearly"
    ]
  },
  "searchTemplates": [
    "{maker} {name} watch dial",
    "{maker} {name} diver wristwatch",
    "{maker} {name} wikimedia commons"
  ],
