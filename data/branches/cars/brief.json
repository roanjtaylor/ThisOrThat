{
  "branch": "cars",
  "rubric": {
    "requiredView": "A clean side profile or 3/4 front angle showing the WHOLE car in frame, so its silhouette and proportions are clearly legible. Exterior only.",
    "minLongEdgePx": 1200,
    "reject": [
      "toy, diecast, or scale model",
      "3D render, CGI, or illustration (must be a real photograph)",
      "heavy watermark, dealer text, or large logo overlay",
      "interior-only or engine-bay-only shot",
      "car cropped or partially out of frame",
      "wrong make / model / generation / year",
      "cluttered background dominated by people or other cars"
    ],
    "prefer": [
      "neutral or plain background (studio, road, or simple landscape)",
      "factory or press photograph",
      "side or 3/4 view showing the full silhouette",
      "good lighting, sharp focus, the car as the clear subject"
    ]
  },
